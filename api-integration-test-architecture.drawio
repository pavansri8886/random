        </mxCell>
        <mxCell id="cod12" value="&lt;b style=&#39;font-size:22px&#39;&gt;4&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Get clients&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod13" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;src/fixtures.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
