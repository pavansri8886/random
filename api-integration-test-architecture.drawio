        <mxCell id="tes26" value="&lt;b&gt;Load test case + baseline&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;baseline may not exist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
