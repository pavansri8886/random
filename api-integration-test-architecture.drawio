        <mxCell id="cod1" value="What happens when api-crew.compare.spec.ts runs" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cod2" value="The spec file only starts the run. The test logic lives once in src/ and is reused by every project, API and endpoint." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cod3" value="&lt;b style=&#39;font-size:22px&#39;&gt;1&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Start&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod4" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;projects/prj-a/api-crew/tests/&lt;br&gt;api-crew.compare.spec.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cod5" value="&lt;font style=&#39;font-size:12px&#39;&gt;3 lines only: takes the api-crew endpoints and hands them to the comparison suite.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cod6" value="&lt;b style=&#39;font-size:22px&#39;&gt;2&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Build the tests&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod7" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;src/suites/&lt;br&gt;comparisonSuite.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="235" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cod8" value="&lt;font style=&#39;font-size:12px&#39;&gt;The actual test logic, written once. Creates one test per test case.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="270" y="295" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cod9" value="&lt;b style=&#39;font-size:22px&#39;&gt;3&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Load what to test&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod10" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;api-crew/endpoints/*.ts&lt;br&gt;api-crew/testdata/*.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="235" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cod11" value="&lt;font style=&#39;font-size:12px&#39;&gt;Endpoint: method, V1 and V2 paths, ignore rules. Test data: inputs and expectations.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="1">
