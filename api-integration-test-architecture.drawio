          <mxGeometry x="40" y="80" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tes3" value="&lt;b&gt;Load test case&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;endpoint definition + test data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="130" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tes4" value="&lt;b&gt;Send the same request&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;to V1 and V2 in parallel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="220" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tes5" value="&lt;b&gt;Normalize both responses&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;ignore fields, sort arrays, drop nulls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="310" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tes6" value="&lt;b&gt;Soft checks&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;V2 status = V1 status&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;V1 status = expectedStatus&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;V2 matches schema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="400" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tes7" value="&lt;b&gt;Deep diff&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;normalized V1 vs normalized V2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tes8" value="Differences?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="205" y="610" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tes9" value="&lt;b&gt;FAIL&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;field level diff in message&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;V1, V2 and diff attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="620" width="200" height="70" as="geometry" />
