        </mxCell>
        <mxCell id="cod14" value="&lt;font style=&#39;font-size:12px&#39;&gt;Uses config/projectConfig.ts to find api-crew in project.config.ts, reads its URLs from env, reuses clients per API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="1">
