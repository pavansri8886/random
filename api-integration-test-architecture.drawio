        <mxCell id="tes10" value="&lt;b&gt;PASS&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="740" width="200" height="50" as="geometry" />
