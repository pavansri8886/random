        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lif1" value="From migration to regression" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lif2" value="&lt;b&gt;1. Build V2&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;V1 and V2 both live&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;add endpoints + test data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lif3" value="&lt;b&gt;2. Compare&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;npm run test:compare&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;fix V2 until V1 = V2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lif4" value="&lt;b&gt;3. Record baselines&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;npm run record:baselines&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;commit baselines/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lif5" value="&lt;b&gt;4. Retire V1&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;remove V1_BASE_URL&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;delete the compare specs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lif6" value="&lt;b&gt;5. V2 regression&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;npm run test:regression&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;in pipelines after each deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1320" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lif7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif2" target="lif3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lif8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif3" target="lif4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lif9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif4" target="lif5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lif10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif5" target="lif6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lif11" value="&lt;b&gt;Same endpoint definitions and test data are used in every step.&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Only the suite that runs changes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lif12" value="&lt;b&gt;Intentional V2 change?&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Add skipComparison with a reason during migration, or update the baseline in the same pull request later.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1540" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
