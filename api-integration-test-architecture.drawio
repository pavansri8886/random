        </mxCell>
        <mxCell id="cod15" value="&lt;b style=&#39;font-size:22px&#39;&gt;5&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Call V1 and V2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod16" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;src/http/apiClient.ts&lt;br&gt;src/http/auth.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="235" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cod17" value="&lt;font style=&#39;font-size:12px&#39;&gt;Sends the same request to both, in parallel, with a cached login token.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="960" y="295" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cod18" value="&lt;b style=&#39;font-size:22px&#39;&gt;6&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Compare&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="130" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cod19" value="📄 &lt;font style=&#39;font-size:11px&#39;&gt;src/compare/&lt;br&gt;normalize.ts + diff.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;fontSize=11;align=center;" vertex="1" parent="1">
